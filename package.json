{
	"name": "dj-stripe.dev",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"fetch-docs": "node scripts/fetch-docs-content.js",
		"build-search-index": "node scripts/build-search-index.js",
		"build": "npm run fetch-docs && npm run build-search-index && next build",
		"start": "next start",
		"lint": "oxlint",
		"format": "prettier --write src/ *.md *.json",
		"type-check": "tsc --noEmit",
		"ci": "oxlint && tsc --noEmit"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"cmdk": "^1.1.1",
		"gray-matter": "^4.0.3",
		"highlight.js": "^11.11.1",
		"next": "16.3.0",
		"next-mdx-remote": "^6.0.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"rehype-highlight": "^7.0.2",
		"remark-gfm": "^4.0.1",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.1.2",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@types/unist": "^3.0.3",
		"oxlint": "^1.77.0",
		"prettier": "^3.9.6",
		"tailwindcss": "^4.3.3",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^7.0.2",
		"whatwg-fetch": "^3.6.20"
	},
	"postcss": {
		"plugins": {
			"@tailwindcss/postcss": {}
		}
	},
	"prettier": {
		"trailingComma": "all",
		"printWidth": 88,
		"useTabs": true,
		"tabWidth": 4,
		"experimentalOperatorPosition": "start",
		"overrides": [
			{
				"files": "*.yml",
				"options": {
					"tabWidth": 2,
					"useTabs": false
				}
			}
		]
	}
}
